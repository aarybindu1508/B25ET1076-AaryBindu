#include <iostream>
using namespace std;

int main(){
    int n, i, j;
    int value;

    cout << "Enter the number of rows: ";
    cin >> n;

    for (i = 0; i < n; i++){        
        for (j = 0; j < n - i - 1; j++){
            cout << " ";
        }
        value = 1;
        for (j = 0; j <= i; j++){
            cout << value << " ";
            value = value * (i - j) / (j + 1);
        }
        cout << endl;
    }
    return 0;
}
