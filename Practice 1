#include <iostream>
using namespace std;


class Student
{
    int prnno, marks;


public:
    void getData()
    {
        cout << "Enter PRN No: ";
        cin >> prnno;


        cout << "Enter Marks: ";
        cin >> marks;
    }


    void displayData()
    {
        cout << "\nPRN No = " << prnno;
        cout << "\nMarks = " << marks;
    }
};


int main()
{
    Student s;


    s.getData();
    s.displayData();


    return 0;
}
